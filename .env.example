# Copy to .env and fill in.
MONGODB_URI=mongodb://127.0.0.1:27017/hitverse
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=4000
# Where the React app runs (used for CORS in dev and for password-reset links)
CLIENT_URL=http://localhost:5173
# Optional: SMTP for password-reset emails. If empty, reset links are printed in the server log.
SMTP_URL=
MAIL_FROM="HitVerse <no-reply@hitverse.app>"
# Upload limits for artists (MB). Masters (WAV/FLAC/AIFF) are converted to 256 kbps AAC with ffmpeg,
# which must be installed on the server (brew install ffmpeg / apt install ffmpeg). FFMPEG_PATH overrides the location.
MAX_AUDIO_MB=250
# Streaming quality for converted uploads: 256k (Apple Music quality, default) or 192k (about 25% smaller, still very good)
AUDIO_BITRATE=256k
# Database size for the storage meter on the admin page (512 = MongoDB Atlas free plan)
STORAGE_LIMIT_MB=512
MAX_COVER_MB=5
# Optional: MusicLink (musiclink.one) fills in Spotify, YouTube Music, Audiomack, Boomplay, Deezer, TIDAL, Amazon Music
# from one link or the song's ISRC. Free plan: 300 lookups a month.
MUSICLINK_API_KEY=
# Optional: lets "Find links automatically" search Spotify too (free app at developer.spotify.com).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Apple Music storefronts to search (some releases are only listed in one)
APPLE_STOREFRONTS=us,ng,gb

# Karaoke and DJ mix: the Python tools in server/audio-tools (see the README). Leave empty to use
# server/audio-tools/.venv/bin/python when it exists.
AUDIO_TOOLS_PYTHON=
# Live rooms (LiveKit). `npm run live:up` starts a local LiveKit server with these development keys.
# In production use LiveKit Cloud or your own server, with its own key and secret, and a wss:// public URL.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Premium prices in naira (karaoke + DJ mode). Empty uses the defaults: ₦300 a week, ₦1,000 a month, ₦10,000 a year.
# The rest of HitVerse's prices (its 15% fee, bants, coin packs) are in server/src/lib/pricing.js.
PREMIUM_WEEKLY_NGN=
PREMIUM_MONTHLY_NGN=
PREMIUM_YEARLY_NGN=
